<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_capture_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_capture_mood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/widget_capture_mood"
            android:textColor="@color/widget_on_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_capture_memory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/widget_capture_memory"
            android:textColor="@color/widget_on_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_capture_journal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/widget_capture_journal"
            android:textColor="@color/widget_on_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_open_luma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/widget_open_luma"
            android:textColor="@color/widget_on_primary"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
