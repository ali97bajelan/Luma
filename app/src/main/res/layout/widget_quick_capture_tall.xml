<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/quick_capture_widget_root" android:layout_width="match_parent"
 android:layout_height="match_parent" android:orientation="vertical"
 android:padding="12dp" android:background="@drawable/widget_background">
<TextView android:fontFamily="@font/widget_sans" android:id="@+id/widget_capture_mood" android:layout_width="match_parent"
 android:layout_height="0dp" android:layout_weight="1"
  android:minWidth="48dp" android:minHeight="48dp" android:gravity="center"
 android:padding="8dp" android:background="@drawable/widget_button_background"
 android:text="@string/widget_capture_mood" android:textSize="16sp" android:textColor="@color/widget_on_primary" />
<TextView android:fontFamily="@font/widget_sans" android:id="@+id/widget_capture_memory" android:layout_width="match_parent"
 android:layout_height="0dp" android:layout_weight="1"
 android:layout_marginTop="8dp" android:minWidth="48dp" android:minHeight="48dp" android:gravity="center"
 android:padding="8dp" android:background="@drawable/widget_button_background"
 android:text="@string/widget_capture_memory" android:textSize="16sp" android:textColor="@color/widget_on_primary" />
<TextView android:fontFamily="@font/widget_sans" android:id="@+id/widget_capture_journal" android:layout_width="match_parent"
 android:layout_height="0dp" android:layout_weight="1"
 android:layout_marginTop="8dp" android:minWidth="48dp" android:minHeight="48dp" android:gravity="center"
 android:padding="8dp" android:background="@drawable/widget_button_background"
 android:text="@string/widget_capture_journal" android:textSize="16sp" android:textColor="@color/widget_on_primary" />
</LinearLayout>
