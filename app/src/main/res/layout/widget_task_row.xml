<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_task_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_target_background"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <TextView android:fontFamily="@font/widget_sans"
            android:id="@+id/widget_task_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textDirection="firstStrong"
            android:textAlignment="viewStart"
            android:gravity="start|center_vertical" />

        <TextView android:fontFamily="@font/widget_sans"
            android:id="@+id/widget_task_row_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_primary"
            android:textSize="14sp"
            android:textDirection="firstStrong"
            android:textAlignment="viewStart"
            android:gravity="start|center_vertical" />
    </LinearLayout>

    <TextView android:fontFamily="@font/widget_sans"
        android:id="@+id/widget_task_row_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_row_action_background"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/widget_mutation_text_light"
        android:textSize="14sp"
        android:maxLines="1"
        android:singleLine="true" />
</LinearLayout>
