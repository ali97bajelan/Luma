<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_task_row_importance_accent"
        android:layout_width="3dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_task_importance_accent_medium_light"
        android:importantForAccessibility="no"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_task_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_row_target_background"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <LinearLayout
            android:id="@+id/widget_task_row_heading_inline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:fontFamily="@font/widget_sans"
                android:id="@+id/widget_task_row_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_primary"
                android:textDirection="firstStrong"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:fontFamily="@font/widget_sans"
                android:id="@+id/widget_task_row_importance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_task_importance_badge_low_light"
                android:gravity="center"
                android:minHeight="24dp"
                android:minWidth="48dp"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary_light"
                android:textDirection="firstStrong"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_task_row_heading_stacked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:fontFamily="@font/widget_sans"
                android:id="@+id/widget_task_row_title_stacked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_primary"
                android:textDirection="firstStrong"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:fontFamily="@font/widget_sans"
                android:id="@+id/widget_task_row_importance_stacked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_task_importance_badge_low_light"
                android:gravity="center"
                android:minHeight="24dp"
                android:minWidth="48dp"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary_light"
                android:textDirection="firstStrong"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:fontFamily="@font/widget_sans"
            android:id="@+id/widget_task_row_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_primary"
            android:textSize="14sp"
            android:textDirection="firstStrong"
            android:textAlignment="viewStart"
            android:gravity="start|center_vertical" />
    </LinearLayout>

    <TextView
        android:fontFamily="@font/widget_sans"
        android:id="@+id/widget_task_row_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_row_action_background"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/widget_mutation_text_light"
        android:textSize="14sp"
        android:maxLines="1"
        android:singleLine="true" />
</LinearLayout>
