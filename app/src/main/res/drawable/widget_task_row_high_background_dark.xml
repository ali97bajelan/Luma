<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_importance_high_glow_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_row_surface_dark" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/widget_importance_high_edge_dark" />
        </shape>
    </item>
</layer-list>
