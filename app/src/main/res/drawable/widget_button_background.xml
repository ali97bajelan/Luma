<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_mutation_fill_pressed_light" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/widget_focus_ring_light" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_mutation_fill_light" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/widget_focus_ring_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_mutation_fill_light" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
