<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="6dp"
    android:insetBottom="6dp">
    <selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_mutation_fill_pressed_dark" />
                <corners android:radius="12dp" />
                <stroke android:width="2dp" android:color="@color/widget_focus_ring_dark" />
            </shape>
        </item>
        <item android:state_focused="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_mutation_fill_dark" />
                <corners android:radius="12dp" />
                <stroke android:width="2dp" android:color="@color/widget_focus_ring_dark" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_mutation_fill_dark" />
                <corners android:radius="12dp" />
            </shape>
        </item>
    </selector>
</inset>
