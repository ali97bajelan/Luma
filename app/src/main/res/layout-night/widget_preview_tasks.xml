<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_preview_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_label"
        android:textColor="@color/widget_text_secondary_dark"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/widget_preview_tasks_title"
            android:textColor="@color/widget_text_primary_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preview_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_count_background_dark"
            android:gravity="center"
            android:minWidth="28dp"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_preview_total_count"
            android:textColor="@color/widget_action_utility_dark"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_background_dark"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_capture"
            android:textColor="@color/widget_mutation_text_dark"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_utility_background_dark"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_action_utility_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_preview_task_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_row_background_dark"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/widget_preview_task"
                android:textColor="@color/widget_text_primary_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_preview_task_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_task_due_today"
                android:textColor="@color/widget_text_secondary_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_preview_task_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_row_action_background_dark"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_preview_task_action"
            android:textColor="@color/widget_mutation_text_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_row_background_dark"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/widget_preview_task_second"
                android:textColor="@color/widget_text_primary_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_preview_task_overdue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_task_overdue"
                android:textColor="@color/widget_overdue_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_row_action_background_dark"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_preview_task_second_action"
            android:textColor="@color/widget_mutation_text_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_scroll_for_more"
        android:textColor="@color/widget_text_secondary_dark"
        android:textSize="12sp" />
</LinearLayout>
